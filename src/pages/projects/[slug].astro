---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Abdul Malik Adz-Dzikri`}>
  <main class="pt-24 min-h-screen">
    <div class="max-w-[1440px] mx-auto px-6 py-12">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-neon transition mb-8">
        <i class="fas fa-arrow-left"></i>
        <span class="text-sm font-bold uppercase tracking-widest">Back to Home</span>
      </a>

      <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-8 md:p-12 [clip-path:polygon(28px_0,100%_0,100%_calc(100%_-_28px),calc(100%_-_28px)_100%,0_100%,0_28px)] relative overflow-hidden">

        <div class="relative z-10">
          <div class="aspect-video [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] mb-10 overflow-hidden shadow-2xl shadow-neon/5">
            <img src={project.image} alt={project.title} class="w-full h-full object-cover hover:scale-105 transition duration-700">
          </div>

          {project.isNativeApp && (
            <div class="mb-4 inline-flex items-center gap-2 px-3 py-1.5 bg-blue-500/10 border border-blue-500/20 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)]">
              <i class="fas fa-microchip text-blue-400 text-xs"></i>
              <span class="text-blue-400 text-xs font-mono">Native Engine Render</span>
            </div>
          )}

          <p class="text-neon text-xs uppercase tracking-widest mb-3">{project.category}</p>
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
            {project.title}
          </h1>

          <div class="flex flex-wrap gap-3 mb-8">
            {project.techStack.map(tech => (
              <span class="text-xs px-3 py-1.5 border border-black/10 dark:border-neon/20 [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase text-gray-600 dark:text-gray-400 font-semibold bg-black/5 dark:bg-neon/[0.04]">
                {tech}
              </span>
            ))}
          </div>

          <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-10">
            {project.fullDescription}
          </p>

          {project.gallery && project.gallery.length > 0 && (
            <section class="mb-10">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <i class="fas fa-images text-neon"></i>
                <span>Gallery</span>
              </h2>
              
              <div class="carousel-wrapper relative group">
                <button class="carousel-nav-btn carousel-prev left-2" aria-label="Previous">
                  <i class="fas fa-chevron-left"></i>
                </button>
                
                <div class="carousel-container">
                  <div class="carousel-track">
                    {project.gallery.map((img, index) => (
                      <div class="carousel-item">
                        <div class="carousel-card">
                          <img src={img.src} alt={img.caption || `Gallery ${index + 1}`} class="carousel-img">
                          <div class="carousel-overlay">
                            <span>{img.caption || 'View'}</span>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <button class="carousel-nav-btn carousel-next right-2" aria-label="Next">
                  <i class="fas fa-chevron-right"></i>
                </button>
              </div>
            </section>
          )}

          <div class="flex flex-wrap gap-4 pt-6 border-t border-black/10 dark:border-neon/20">
            {project.liveLink && project.liveLink !== '#' && (
              <a href={project.liveLink} target="_blank" class="btn">
                <i class="fas fa-external-link-alt mr-2"></i>
                <span>Live Demo</span>
              </a>
            )}
            {project.githubLink && project.githubLink !== '#' && (
              <a href={project.githubLink} target="_blank" class="btn outline">
                <i class="fab fa-github mr-2"></i>
                <span>Source Code</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.carousel-wrapper').forEach(wrapper => {
    const track = wrapper.querySelector('.carousel-track');
    const prevBtn = wrapper.querySelector('.carousel-prev');
    const nextBtn = wrapper.querySelector('.carousel-next');
    const itemWidth = 280;
    const gap = 24;
    let scrollPosition = 0;

    prevBtn?.addEventListener('click', () => {
      scrollPosition = Math.max(scrollPosition - (itemWidth + gap), 0);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const maxScroll = (track?.scrollWidth || 0) - (track?.clientWidth || 0);
      scrollPosition = Math.min(scrollPosition + (itemWidth + gap), maxScroll);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });
  });
</script>

<style>
  .carousel-wrapper {
    position: relative;
  }

  .carousel-container {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .carousel-container::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    display: flex;
    gap: 6;
    padding: 0 4px;
  }

  .carousel-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 0 12px;
  }

  .carousel-card {
    position: relative;
    width: 280px;
    aspect-ratio: 9/16;
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.18), 0 8px 24px rgba(0,0,0,0.5);
  }

  .carousel-card:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 20px rgb(var(--accent-rgb) / 0.3);
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }

  .carousel-card:hover .carousel-img {
    transform: scale(1.1);
  }

  .carousel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20px;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .carousel-card:hover .carousel-overlay {
    opacity: 1;
  }

  .carousel-overlay span {
    color: white;
    font-size: 14px;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .carousel-wrapper:hover .carousel-nav-btn {
    opacity: 1;
  }

  .carousel-nav-btn:hover {
    background: rgb(var(--accent-rgb) / 0.2);
    border-color: var(--color-gold, var(--accent));
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: var(--color-gold, var(--accent));
    color: #000;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgb(var(--accent-rgb) / 0.3);
  }

  .btn.outline {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
  }

  .btn.outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-gold, var(--accent));
  }
</style>
