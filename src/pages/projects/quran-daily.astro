---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Quran Daily - UI/UX Case Study | Abdul Malik Adz-Dzikri">
  <main class="pt-24 min-h-screen">
    <div class="max-w-[1440px] mx-auto px-6 py-12">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-neon transition mb-8">
        <i class="fas fa-arrow-left"></i>
        <span class="text-sm font-bold uppercase tracking-widest">Back to Home</span>
      </a>

      <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 [clip-path:polygon(28px_0,100%_0,100%_calc(100%_-_28px),calc(100%_-_28px)_100%,0_100%,0_28px)] relative overflow-hidden">

        <div class="relative z-10 p-8 md:p-12">
          <header class="mb-10">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-semibold [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase tracking-wider">UI/UX Case Study</span>
              <span class="px-3 py-1 bg-black/5 dark:bg-neon/10 text-gray-600 dark:text-gray-400 text-xs font-semibold [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase tracking-wider">Mobile App Design</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Quran Daily</h1>
            <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl">
              Perancangan antarmuka pengguna (UI) dan pengalaman pengguna (UX) untuk aplikasi membaca Al-Quran harian yang berfokus pada kenyamanan visual, habit tracking, dan kemudahan navigasi.
            </p>
          </header>

          <section class="mb-12">
            <div class="aspect-video [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] overflow-hidden border border-black/10 dark:border-neon/20 mb-10 shadow-2xl shadow-neon/10">
              <img src={`${import.meta.env.BASE_URL}img/qd.png`} alt="Quran Daily Main Preview - Mobile App Design" class="w-full h-full object-cover hover:scale-105 transition duration-700">
            </div>

            <div class="mb-4 inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/20 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)]">
              <i class="fas fa-mobile-alt text-emerald-400 text-xs"></i>
              <span class="text-emerald-400 text-xs font-mono">Mobile App UI/UX Design</span>
            </div>

            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2 mt-6">
              <i class="fas fa-images text-neon"></i>
              <span>Gallery</span>
            </h2>
            
            <div class="carousel-wrapper relative group">
              <button class="carousel-nav-btn carousel-prev left-2" aria-label="Previous">
                <i class="fas fa-chevron-left"></i>
              </button>
              
              <div class="carousel-container">
                <div class="carousel-track">
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/qd (1).png`} alt="Home Screen" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Home Screen</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/qd (2).png`} alt="Reading View" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Reading View</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/qd (3).png`} alt="Progress Tracker" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Progress Tracker</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/qd (4).png`} alt="Settings" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Settings</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <button class="carousel-nav-btn carousel-next right-2" aria-label="Next">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Deskripsi Proyek
            </h2>
            <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                Quran Daily adalah studi kasus desain aplikasi mobile yang bertujuan meningkatkan konsistensi membaca Al-Quran melalui UI yang tenang dan fitur pelacakan progres. Desain ini berfokus pada <span class="font-mono text-emerald-400">kenyamanan visual</span>, <span class="font-mono text-teal-400">habit tracking</span>, dan <span class="font-mono text-emerald-400">kemudahan navigasi</span> sehingga pengguna dapat fokus pada bacaan tanpa gangguan.
              </p>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Technology Stack & Tools
            </h2>
            
            <div class="mb-6">
              <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Design Tools</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fab fa-figma text-3xl text-purple-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Figma</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fab fa-adobe text-3xl text-orange-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Adobe Illustrator</p>
                </div>
              </div>
            </div>

            <div class="mb-6">
              <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">UX Methodology</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-users text-3xl text-blue-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">User Research</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-heart text-3xl text-pink-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Empathy Map</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-project-diagram text-3xl text-yellow-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">User Flow</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-pencil-ruler text-3xl text-cyan-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Wireframing</p>
                </div>
              </div>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Visual Style</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/30 transition hover:scale-105">
                  <i class="fas fa-gem text-3xl text-neon mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Glassmorphism</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-font text-3xl text-green-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Clean Typography</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-moon text-3xl text-indigo-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Dark Mode</p>
                </div>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Fitur Utama
            </h2>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-emerald-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-emerald-400">
                    <i class="fas fa-book-open"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Daily Reading</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Tampilan bacaan Al-Quran yang tenang dan nyaman</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-teal-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-teal-400">
                    <i class="fas fa-chart-line"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Habit Tracking</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Pelacakan progres membaca harian</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-purple-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-purple-400">
                    <i class="fas fa-bookmark"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Bookmark System</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Tandai posisi terakhir bacaan</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-cyan-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-cyan-400">
                    <i class="fas fa-adjust"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Theme Toggle</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Dukungan light dan dark mode</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/30 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-neon/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-neon">
                    <i class="fas fa-language"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Translation Support</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Tampilan terjemahan dan tafsir</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-green-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-green-400">
                    <i class="fas fa-bell"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Daily Reminder</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Pengingat membaca Al-Quran harian</p>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Kontribusi Saya
            </h2>
            <div class="bg-gradient-to-r from-emerald-500/10 via-neon/10 to-teal-500/10 border border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">User Research:</strong> Melakukan riset pengguna untuk memahami kebutuhan dan pain points pengguna dalam membaca Al-Quran harian.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Wireframing:</strong> Membuat wireframe menggunakan FigJam untuk memvisualisasikan alur pengguna.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">High-Fidelity Design:</strong> Merancang desain antarmuka berkualitas tinggi dengan fokus pada tipografi bersih dan glassmorphism.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Prototyping:</strong> Membuat prototipe interaktif di Figma untuk menguji UX sebelum development.</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Design Process
            </h2>
            <div class="bg-gradient-to-r from-purple-500/5 to-emerald-500/5 border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                Proses desain dimulai dengan <span class="font-mono text-purple-400">User Research</span> untuk memahami kebiasaan pengguna dalam membaca Al-Quran. Kemudian membuat <span class="font-mono text-blue-400">Empathy Map</span> dan <span class="font-mono text-yellow-400">User Flow</span> untuk merancang pengalaman yang intuitif. Wireframe dibuat di FigJam sebelum akhirnya mengembangkan <span class="font-mono text-emerald-400">High-Fidelity Design</span> di Figma dengan menerapkan prinsip visual modern seperti glassmorphism dan dark mode yang optimal untuk kenyamanan mata.
              </p>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Expertise
            </h2>
            <div class="bg-gradient-to-r from-emerald-500/5 to-teal-500/5 border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                Proyek ini menunjukkan kemampuan dalam <strong class="text-gray-900 dark:text-white font-mono text-sm">Mobile App Design</strong> dengan fokus pada <strong class="text-gray-900 dark:text-white font-mono text-sm">User Experience</strong>. Kompetensi yang dikembangkan meliputi riset pengguna, pembuatan user flow, wireframing, desain antarmuka yang estetis dengan glassmorphism, dan pembuatan prototipe interaktif menggunakan Figma.
              </p>
            </div>
          </section>

          <div class="flex flex-wrap gap-4 pt-8 border-t border-black/10 dark:border-neon/20">
            <a href="#" target="_blank" class="btn-figma flex items-center gap-3">
              <i class="fab fa-figma text-xl"></i>
              <span>View Figma Prototype</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.carousel-wrapper').forEach(wrapper => {
    const track = wrapper.querySelector('.carousel-track');
    const prevBtn = wrapper.querySelector('.carousel-prev');
    const nextBtn = wrapper.querySelector('.carousel-next');
    const itemWidth = 240;
    const gap = 20;
    let scrollPosition = 0;

    prevBtn?.addEventListener('click', () => {
      scrollPosition = Math.max(scrollPosition - (itemWidth + gap), 0);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const maxScroll = (track?.scrollWidth || 0) - (track?.clientWidth || 0);
      scrollPosition = Math.min(scrollPosition + (itemWidth + gap), maxScroll);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });
  });
</script>

<style>
  .carousel-wrapper {
    position: relative;
  }

  .carousel-container {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
