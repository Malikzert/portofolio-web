---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="E-Presensi - Sistem Absensi Berbasis Web | Abdul Malik Adz-Dzikri">
  <main class="pt-24 min-h-screen">
    <div class="max-w-[1440px] mx-auto px-6 py-12">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-neon transition mb-8">
        <i class="fas fa-arrow-left"></i>
        <span class="text-sm font-bold uppercase tracking-widest">Back to Home</span>
      </a>

      <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 [clip-path:polygon(28px_0,100%_0,100%_calc(100%_-_28px),calc(100%_-_28px)_100%,0_100%,0_28px)] relative overflow-hidden">

        <div class="relative z-10 p-8 md:p-12">
          <header class="mb-10">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-blue-500/20 text-blue-400 text-xs font-semibold [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase tracking-wider">Completed</span>
              <span class="px-3 py-1 bg-black/5 dark:bg-neon/10 text-gray-600 dark:text-gray-400 text-xs font-semibold [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase tracking-wider">Web App</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">E-Presensi</h1>
            <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl">
              Sistem manajemen absensi digital yang efisien untuk institusi, mendukung pencatatan kehadiran secara real-time dan pelaporan otomatis.
            </p>
          </header>

          <section class="mb-12">
            <div class="aspect-video [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] overflow-hidden border border-black/10 dark:border-neon/20 mb-10 shadow-2xl shadow-neon/10">
              <img src={`${import.meta.env.BASE_URL}img/epres.png`} alt="E-Presensi Main Preview - Web Application" class="w-full h-full object-cover hover:scale-105 transition duration-700">
            </div>

            <div class="mb-4 inline-flex items-center gap-2 px-3 py-1.5 bg-blue-500/10 border border-blue-500/20 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)]">
              <i class="fas fa-desktop text-blue-400 text-xs"></i>
              <span class="text-blue-400 text-xs font-mono">PHP Native Web App</span>
            </div>

            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2 mt-6">
              <i class="fas fa-images text-neon"></i>
              <span>Gallery</span>
            </h2>
            
            <div class="carousel-wrapper relative group">
              <button class="carousel-nav-btn carousel-prev left-2" aria-label="Previous">
                <i class="fas fa-chevron-left"></i>
              </button>
              
              <div class="carousel-container">
                <div class="carousel-track">
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/epres (1).png`} alt="Dashboard Screenshot" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Admin Dashboard</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/epres (2).png`} alt="Attendance Form" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Attendance Form</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/epres (3).png`} alt="Report View" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Report View</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/epres (4).png`} alt="User Profile" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>User Profile</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <button class="carousel-nav-btn carousel-next right-2" aria-label="Next">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Deskripsi Proyek
            </h2>
            <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                E-Presensi adalah platform manajemen kehadiran digital yang memungkinkan pengguna melakukan absensi secara real-time dengan integrasi <span class="font-mono text-blue-400">Geolocation API</span> untuk validasi lokasi. Sistem ini dibangun dengan <span class="font-mono text-orange-400">Laravel Framework</span> yang dioptimalkan untuk performa tinggi dan <span class="font-mono text-blue-400">MySQL</span> sebagai database struktural. Aplikasi ini menyediakan dashboard admin untuk mengelola data kehadiran, menghasilkan laporan otomatis, dan memantau statistik kehadiran secara real-time.
              </p>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Technology Stack
            </h2>
            
            <div class="mb-6">
              <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Core Framework & Language</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fab fa-laravel text-3xl text-red-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Laravel</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-database text-3xl text-blue-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">MySQL</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fab fa-php text-3xl text-purple-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">PHP 8+</p>
                </div>
              </div>
            </div>

            <div class="mb-6">
              <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Service & API Integration</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-map-marker-alt text-3xl text-green-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Geolocation API</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-hdd text-3xl text-yellow-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Local Storage</p>
                </div>
              </div>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-3">Development Tools</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-code text-3xl text-blue-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">VS Code</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-server text-3xl text-red-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">XAMPP</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fab fa-git-alt text-3xl text-orange-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Git</p>
                </div>
                <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                  <i class="fas fa-terminal text-3xl text-green-500 mb-2"></i>
                  <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Laragon</p>
                </div>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Fitur Utama
            </h2>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-blue-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-blue-400">
                    <i class="fas fa-map-pin"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Geolocation Validation</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Validasi lokasi absensi menggunakan Google Maps API</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-green-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-green-400">
                    <i class="fas fa-clock"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Real-time Clock</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Pencatatan waktu kehadiran yang akurat</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-purple-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-purple-400">
                    <i class="fas fa-chart-bar"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Auto Reporting</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Generasi laporan kehadiran otomatis</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-yellow-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-yellow-400">
                    <i class="fas fa-user-shield"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">User Authentication</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Sistem login dan registrasi pengguna</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-cyan-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-cyan-400">
                    <i class="fas fa-table"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Data Export</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Export data ke Excel dan PDF</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-red-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-red-400">
                    <i class="fas fa-bell"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Notifications</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Notifikasi absensi masuk dan pulang</p>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Kontribusi Saya
            </h2>
            <div class="bg-gradient-to-r from-blue-500/10 via-neon/10 to-cyan-500/10 border border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Full-stack Developer:</strong> Mengembangkan aplikasi web secara keseluruhan mulai dari frontend hingga backend menggunakan PHP Native.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Database Design:</strong> Merancang struktur database MySQL untuk menyimpan data absensi, pengguna, dan laporan.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Geolocation Integration:</strong> Mengintegrasikan Geolocation API untuk validasi lokasi kehadiran pengguna.</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Technical Challenges
            </h2>
            <div class="bg-gradient-to-r from-purple-500/5 to-blue-500/5 border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                Tantangan utama dalam proyek ini adalah mengoptimalkan query database untuk menangani data absensi dalam jumlah besar. Penggunaan <span class="font-mono text-blue-400">indeks database</span> yang tepat dan <span class="font-mono text-blue-400">query optimization</span> menjadi fokus utama untuk memastikan aplikasi tetap responsif. Selain itu, penanganan <span class="font-mono text-green-400">session management</span> yang aman dan validasi data real-time memerlukan implementasi yang cermat untuk mencegah inkonsistensi data.
              </p>
              <div class="mt-4 p-4 bg-black/30 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] border border-black/10 dark:border-white/5">
                <p class="text-xs text-gray-600 dark:text-gray-500 font-mono">
                  <span class="text-purple-400">$query</span> = "SELECT * FROM attendance <span class="text-blue-400">WHERE</span> user_id = ? <span class="text-blue-400">AND</span> date = ?";<br>
                  <span class="text-yellow-400">$stmt</span>->prepare(<span class="text-green-400">$query</span>);
                </p>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Expertise
            </h2>
            <div class="bg-gradient-to-r from-blue-500/5 to-cyan-500/5 border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                Proyek ini menunjukkan kemampuan dalam <strong class="text-gray-900 dark:text-white font-mono text-sm">PHP Native Development</strong> dan <strong class="text-gray-900 dark:text-white font-mono text-sm">MySQL Database Management</strong>. Penguasaan terhadap konsep RESTful thinking dalam design aplikasi web, security best practices untuk authentication, dan optimasi query database menjadi kompetensi utama yang dikembangkan melalui proyek E-Presensi.
              </p>
            </div>
          </section>

          <div class="flex flex-wrap gap-4 pt-8 border-t border-black/10 dark:border-neon/20">
            <a href="https://github.com/Malikzert/e-presensi" target="_blank" class="btn-github flex items-center gap-3">
              <i class="fab fa-github text-xl"></i>
              <span>Source Code</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.carousel-wrapper').forEach(wrapper => {
    const track = wrapper.querySelector('.carousel-track');
    const prevBtn = wrapper.querySelector('.carousel-prev');
    const nextBtn = wrapper.querySelector('.carousel-next');
    const itemWidth = 280;
    const gap = 24;
    let scrollPosition = 0;

    prevBtn?.addEventListener('click', () => {
      scrollPosition = Math.max(scrollPosition - (itemWidth + gap), 0);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const maxScroll = (track?.scrollWidth || 0) - (track?.clientWidth || 0);
      scrollPosition = Math.min(scrollPosition + (itemWidth + gap), maxScroll);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });
  });
