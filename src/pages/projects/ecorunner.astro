---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Eco Runner - 2D Platformer Educational Game | Abdul Malik Adz-Dzikri">
  <main class="pt-24 min-h-screen">
    <div class="max-w-[1440px] mx-auto px-6 py-12">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-neon transition mb-8">
        <i class="fas fa-arrow-left"></i>
        <span class="text-sm font-bold uppercase tracking-widest">Back to Home</span>
      </a>

      <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 [clip-path:polygon(28px_0,100%_0,100%_calc(100%_-_28px),calc(100%_-_28px)_100%,0_100%,0_28px)] relative overflow-hidden">

        <div class="relative z-10 p-8 md:p-12">
          <header class="mb-10">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-semibold [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase tracking-wider">Completed</span>
              <span class="px-3 py-1 bg-black/5 dark:bg-neon/10 text-gray-600 dark:text-gray-400 text-xs font-semibold [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] uppercase tracking-wider">Godot Engine</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Eco Runner</h1>
            <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl">
              Game edukasi bertema lingkungan yang menantang pemain untuk mengumpulkan sampah dan menjaga kebersihan dunia digital sambil melewati berbagai rintangan platformer.
            </p>
          </header>

          <section class="mb-12">
            <div class="aspect-video [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] overflow-hidden border border-black/10 dark:border-neon/20 mb-10 shadow-2xl shadow-neon/10">
              <img src={`${import.meta.env.BASE_URL}img/eco (1).png`} alt="Eco Runner Main Preview - Godot Engine Game" class="w-full h-full object-cover hover:scale-105 transition duration-700">
            </div>

            <div class="mb-4 inline-flex items-center gap-2 px-3 py-1.5 bg-green-500/10 border border-green-500/20 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)]">
              <i class="fas fa-gamepad text-green-400 text-xs"></i>
              <span class="text-green-400 text-xs font-mono">GDScript Platformer</span>
            </div>

            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2 mt-6">
              <i class="fas fa-images text-neon"></i>
              <span>Gallery</span>
            </h2>
            
            <div class="carousel-wrapper relative group">
              <button class="carousel-nav-btn carousel-prev left-2" aria-label="Previous">
                <i class="fas fa-chevron-left"></i>
              </button>
              
              <div class="carousel-container">
                <div class="carousel-track">
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/eco (2).png`} alt="Gameplay Screenshot 1" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Level 1 - Forest</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/eco (3).png`} alt="Gameplay Screenshot 2" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Trash Collection</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/eco (4).png`} alt="Gameplay Screenshot 3" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>UI Dashboard</span>
                      </div>
                    </div>
                  </div>
                  <div class="carousel-item">
                    <div class="carousel-card">
                      <img src={`${import.meta.env.BASE_URL}img/eco (5).png`} alt="Gameplay Screenshot 4" class="carousel-img">
                      <div class="carousel-overlay">
                        <span>Obstacle Challenge</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <button class="carousel-nav-btn carousel-next right-2" aria-label="Next">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Deskripsi Proyek
            </h2>
            <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                Eco Runner adalah game platformer 2D edukatif yang dibangun menggunakan <span class="font-mono text-green-400">Godot Engine</span> dengan bahasa pemrograman <span class="font-mono text-yellow-400">GDScript</span>. Game ini menggabungkan mekanisme platformer yang menarik dengan pesan edukasi tentang pentingnya menjaga kebersihan lingkungan. Pemain harus melompat, menghindari rintangan, dan mengumpulkan sampah yang tersebar di setiap level untuk mendapatkan skor tinggi sambil mempelajari cara-cara sederhana namun efektif untuk merawat lingkungan sekitar.
              </p>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Technology Stack
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                <i class="fas fa-gamepad text-3xl text-green-500 mb-2"></i>
                <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Godot Engine</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                <i class="fas fa-code text-3xl text-blue-500 mb-2"></i>
                <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">GDScript</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                <i class="fas fa-tile text-3xl text-yellow-500 mb-2"></i>
                <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">TileMap</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-4 [clip-path:polygon(12px_0,100%_0,100%_calc(100%_-_12px),calc(100%_-_12px)_100%,0_100%,0_12px)] text-center hover:border-neon/60 transition hover:scale-105">
                <i class="fas fa-paint-brush text-3xl text-purple-500 mb-2"></i>
                <p class="text-gray-700 dark:text-gray-300 text-sm font-mono">Godot Shaders</p>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Fitur Utama
            </h2>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-green-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-green-400">
                    <i class="fas fa-running"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Player Movement</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Implementasi fisika karakter termasuk lompat, dash, dan gravity</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-yellow-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-yellow-400">
                    <i class="fas fa-recycle"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Trash Collection</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Sistem interaksi untuk mengambil dan mengkategorikan sampah</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-blue-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-blue-400">
                    <i class="fas fa-th-large"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">TileMap Design</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Pembangunan level menggunakan TileSet editor Godot</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-red-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-red-400">
                    <i class="fas fa-heart"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Health System</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Implementasi health bar dan damage detection</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-purple-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-purple-400">
                    <i class="fas fa-star"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Scoring System</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Perhitungan skor berbasis performa dan bonus waktu</p>
              </div>
              <div class="bg-black/5 dark:bg-neon/[0.04] border border-black/10 dark:border-neon/20 p-5 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)] hover:border-neon/60 transition hover:scale-[1.02]">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-cyan-500/10 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] flex items-center justify-center text-cyan-400">
                    <i class="fas fa-mobile-alt"></i>
                  </div>
                  <h3 class="text-gray-900 dark:text-white font-semibold font-mono text-sm">Responsive Controls</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-500 text-xs mt-2 ml-13">Dukungan keyboard dan touch input untuk berbagai device</p>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Kontribusi Saya
            </h2>
            <div class="bg-gradient-to-r from-green-500/10 via-neon/10 to-emerald-500/10 border border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Core Gameplay Programmer:</strong> Mengembangkan logika utama pergerakan karakter, sistem deteksi tabrakan (collision), dan mekanik pengumpulan item menggunakan GDScript.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">UI & HUD Developer:</strong> Merancang dan mengimplementasikan User Interface dalam game, termasuk sistem skoring dan health bar.</span>
                </li>
                <li class="flex items-start gap-3">
                  <i class="fas fa-check-circle text-neon mt-1"></i>
                  <span class="text-gray-700 dark:text-gray-300"><strong class="text-gray-900 dark:text-white font-mono text-sm">Level Design Integration:</strong> Menyusun tilemaps dan mengatur alur rintangan untuk memastikan pengalaman bermain yang balance.</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Technical Challenges
            </h2>
            <div class="bg-gradient-to-r from-purple-500/5 to-green-500/5 border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                Dalam pengembangan game 2D ini, beberapa tantangan teknis utama yang dihadapi meliputi optimasi performa untuk device dengan spesifikasi rendah. Penggunaan <span class="font-mono text-green-400">Area2D</span> dan <span class="font-mono text-green-400">KinematicBody2D</span> memerlukan careful tuning untuk memastikan collision detection tetap akurat tanpa memberatkan CPU. Selain itu, pengelolaan memory untuk projectile dan particle effects membutuhkan pendekatan khusus agar game tetap responsif pada 60 FPS.
              </p>
              <div class="mt-4 p-4 bg-black/30 [clip-path:polygon(8px_0,100%_0,100%_calc(100%_-_8px),calc(100%_-_8px)_100%,0_100%,0_8px)] border border-black/10 dark:border-white/5">
                <p class="text-xs text-gray-600 dark:text-gray-500 font-mono">
                  <span class="text-green-400">extends</span> KinematicBody2D<br><br>
                  <span class="text-blue-400">func</span> <span class="text-yellow-400">_physics_process</span>(delta):<br>
                  &nbsp;&nbsp;<span class="text-purple-400">velocity</span> = move_and_slide(velocity)<br>
                  &nbsp;&nbsp;<span class="text-purple-400">velocity</span>.y += gravity * delta
                </p>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="w-1 h-8 bg-neon [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)]"></span>
              Expertise
            </h2>
            <div class="bg-gradient-to-r from-green-500/5 to-emerald-500/5 border border-black/10 dark:border-neon/20 p-6 [clip-path:polygon(18px_0,100%_0,100%_calc(100%_-_18px),calc(100%_-_18px)_100%,0_100%,0_18px)]">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                Proyek ini menunjukkan kemampuan dalam <strong class="text-gray-900 dark:text-white font-mono text-sm">Game Development</strong> menggunakan Godot Engine dan <strong class="text-gray-900 dark:text-white font-mono text-sm">GDScript Programming</strong>. Penguasaan terhadap physics engine 2D Godot, tilemap design, dan optimasi performa game menjadi fokus utama dalam pengembangan proyek ini. Kemampuan untuk translate mechanic design menjadi code yang efisien merupakan kompetensi kunci yang dikembangkan melalui proyek Eco Runner.
              </p>
            </div>
          </section>

          <div class="flex flex-wrap gap-4 pt-8 border-t border-black/10 dark:border-neon/20">
            <a href="https://www.youtube.com/watch?v=OAD9YXr3jrU" target="_blank" class="btn-youtube flex items-center gap-3">
              <i class="fab fa-youtube text-xl"></i>
              <span>Watch Demo</span>
            </a>
            <a href="https://github.com/Malikzert/ProyekPPLGame" target="_blank" class="btn-github flex items-center gap-3">
              <i class="fab fa-github text-xl"></i>
              <span>Source Code</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.carousel-wrapper').forEach(wrapper => {
    const track = wrapper.querySelector('.carousel-track');
    const prevBtn = wrapper.querySelector('.carousel-prev');
    const nextBtn = wrapper.querySelector('.carousel-next');
    const itemWidth = 280;
    const gap = 24;
    let scrollPosition = 0;

    prevBtn?.addEventListener('click', () => {
      scrollPosition = Math.max(scrollPosition - (itemWidth + gap), 0);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const maxScroll = (track?.scrollWidth || 0) - (track?.clientWidth || 0);
      scrollPosition = Math.min(scrollPosition + (itemWidth + gap), maxScroll);
      track?.scrollTo({ left: scrollPosition, behavior: 'smooth' });
    });
  });
</script>

<style>
  .carousel-wrapper {
    position: relative;
  }

  .carousel-container {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .carousel-container::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    display: flex;
    gap: 0;
    padding: 0 4px;
  }

  .carousel-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 0 12px;
  }

  .carousel-card {
    position: relative;
    width: 280px;
    aspect-ratio: 16/9;
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.18), 0 8px 24px rgba(0,0,0,0.5);
  }

  .carousel-card:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 20px rgb(var(--accent-rgb) / 0.4);
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }

  .carousel-card:hover .carousel-img {
    transform: scale(1.1);
  }

  .carousel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20px;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .carousel-card:hover .carousel-overlay {
    opacity: 1;
  }

  .carousel-overlay span {
    color: white;
    font-size: 14px;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .carousel-wrapper:hover .carousel-nav-btn {
