---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Abdul Malik Adz-Dzikri - Informatika Portfolio" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		
		<script is:inline>
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							dark: '#050508',
							accent: '#f5e6a8',
							gold: '#f5e6a8',
						}
					}
				}
			}
		</script>
		<script is:inline data-astro-rerun>
			(function () {
				var doc = document.documentElement;
				var stored = null;
				try { stored = localStorage.getItem('theme'); } catch (e) {}
				var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
				var dark = stored ? stored === 'dark' : prefersDark;
				doc.classList.toggle('dark', dark);

				function syncIcons() {
					var isDark = doc.classList.contains('dark');
					var icons = document.querySelectorAll('[data-theme-icon]');
					for (var i = 0; i < icons.length; i++) {
						icons[i].classList.toggle('fa-moon', isDark);
						icons[i].classList.toggle('fa-sun', !isDark);
					}
				}

				if (!doc.__themeBound) {
					doc.__themeBound = true;
					document.addEventListener('click', function (e) {
						var btn = e.target.closest ? e.target.closest('[data-theme-toggle]') : null;
						if (!btn) return;
						var isDark = doc.classList.toggle('dark');
						try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (err) {}
						syncIcons();
					});
				}

				syncIcons();
			})();
		</script>
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="bg-white dark:bg-dark text-gray-700 dark:text-gray-300 font-['Poppins'] overflow-x-hidden">
		<Header />
		<slot />
	</body>
</html>
