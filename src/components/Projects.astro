---
import { projects } from '../data/projects.js';
---

<section id="projects" class="py-24 w-full">
    <div class="container w-full max-w-[1440px] mx-auto px-5">
        <div class="section-header text-center mb-12">
            <p class="small">// Portofolio Kerja</p>
            <h2 class="section-title">Selected <span>Projects</span></h2>
        </div>

        <div class="relative">
            <button class="carousel-btn prev" id="prevBtn">
                <i class="fas fa-chevron-left text-dark"></i>
            </button>
            <button class="carousel-btn next" id="nextBtn">
                <i class="fas fa-chevron-right text-dark"></i>
            </button>

            <div class="carousel-wrapper overflow-hidden">
                <div class="project-track flex gap-8 transition-transform duration-500" id="projectTrack">
                    {projects.map((project) => (
                        <div class="project-card min-w-[calc(33.333%-20px)]">
                            <div class="project-img-wrapper relative">
                                <img src={project.image} alt={project.title}>
                                <span class="absolute top-3 left-3 z-10 text-[9px] font-display uppercase tracking-widest px-2 py-1 bg-dark/70 text-neon border border-neon/40 [clip-path:polygon(4px_0,100%_0,100%_calc(100%_-_4px),calc(100%_-_4px)_100%,0_100%,0_4px)]">
                                    {project.category}
                                </span>
                                <div class="project-overlay">
                                    <a href={`${import.meta.env.BASE_URL}projects/${project.slug}`} class="btn">Details</a>
                                </div>
                            </div>
                            <div class="project-info">
                                <span class="category">{project.category}</span>
                                <h3 class="font-display">{project.title}</h3>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>
