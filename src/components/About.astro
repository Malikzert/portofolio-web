---
---
<section id="about" class="py-24 w-full">
    <div class="container w-full max-w-[1200px] mx-auto px-5">
        <div class="flex flex-col md:flex-row items-center gap-16">
            
            <div class="flex-1">
                <p class="small">Tentang Saya</p>
                <h2 class="section-title mb-6">Professional <span>Profile</span></h2>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-8">
                    Saya adalah mahasiswa Informatika yang berdedikasi untuk menciptakan solusi digital yang efisien. 
                    Dengan latar belakang teknis yang kuat, saya fokus pada pengembangan web yang menggabungkan 
                    estetika modern dengan fungsionalitas formal.
                </p>
                <a href={`${import.meta.env.BASE_URL}cv`} target="_blank" rel="noopener noreferrer" class="btn outline">Download CV</a>
            </div>

            <div class="flex-1 w-full">
                <div class="skill-item">
                    <span>Frontend</span>
                    <div class="skill-bar"><div class="progress" style="width: 90%;"></div></div>
                </div>
                <div class="skill-item">
                    <span>Backend</span>
                    <div class="skill-bar"><div class="progress" style="width: 75%;"></div></div>
                </div>
                <div class="skill-item">
                    <span>UI/UX Design</span>
                    <div class="skill-bar"><div class="progress" style="width: 80%;"></div></div>
                </div>
                <div class="skill-item">
                    <span>Data Analysis</span>
                    <div class="skill-bar"><div class="progress" style="width: 70%;"></div></div>
                </div>
            </div>
        </div>

        <div class="mt-24">
            <p class="small text-center">Keahlian Teknis</p>
            <h2 class="section-title text-center mb-12">Tech <span>Stack</span> & <span>Tools</span></h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="tech-card p-6 rounded-2xl" style="background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(10px);">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-[var(--accent)]/10 flex items-center justify-center">
                            <i class="fas fa-desktop text-[var(--accent)]"></i>
                        </div>
                        <h3 class="text-lg font-semibold" style="color: var(--accent);">Sistem Operasi</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-windows mr-2"></i>Windows
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-ubuntu mr-2 text-orange-400"></i>Ubuntu
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-debian mr-2 text-red-400"></i>Debian
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-linux mr-2 text-green-400"></i>Mint
                        </span>
                    </div>
                </div>

                <div class="tech-card p-6 rounded-2xl" style="background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(10px);">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-[var(--accent)]/10 flex items-center justify-center">
                            <i class="fas fa-code text-[var(--accent)]"></i>
                        </div>
                        <h3 class="text-lg font-semibold" style="color: var(--accent);">Languages & Markup</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-html5 mr-2 text-orange-500"></i>HTML5
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-css3-alt mr-2 text-blue-500"></i>CSS3
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-js mr-2 text-yellow-400"></i>JavaScript
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-python mr-2 text-yellow-300"></i>Python
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-php mr-2 text-indigo-400"></i>PHP
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-hashtag mr-2 text-purple-400"></i>C#
                        </span>
                    </div>
                </div>

                <div class="tech-card p-6 rounded-2xl" style="background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(10px);">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-[var(--accent)]/10 flex items-center justify-center">
                            <i class="fas fa-layer-group text-[var(--accent)]"></i>
                        </div>
                        <h3 class="text-lg font-semibold" style="color: var(--accent);">Frameworks</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-rocket mr-2 text-purple-400"></i>Astro
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-laravel mr-2 text-red-500"></i>Laravel
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-python mr-2 text-green-400"></i>Flask
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-chart-line mr-2 text-cyan-400"></i>Streamlit
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-bootstrap mr-2 text-purple-500"></i>Bootstrap
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-tailwind mr-2 text-cyan-400"></i>Tailwind
                        </span>
                    </div>
                </div>

                <div class="tech-card p-6 rounded-2xl" style="background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(10px);">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-[var(--accent)]/10 flex items-center justify-center">
                            <i class="fas fa-database text-[var(--accent)]"></i>
                        </div>
                        <h3 class="text-lg font-semibold" style="color: var(--accent);">Databases</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-database mr-2 text-blue-400"></i>MySQL
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-database mr-2 text-indigo-400"></i>PostgreSQL
                        </span>
                    </div>
                </div>

                <div class="tech-card p-6 rounded-2xl col-span-1 md:col-span-2 lg:col-span-2" style="background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(10px);">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-[var(--accent)]/10 flex items-center justify-center">
                            <i class="fas fa-tools text-[var(--accent)]"></i>
                        </div>
                        <h3 class="text-lg font-semibold" style="color: var(--accent);">Tools & Environment</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-figma mr-2 text-pink-400"></i>Figma
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-draw-polygon mr-2 text-orange-400"></i>Draw.io
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-code-branch mr-2 text-blue-400"></i>VS Code
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-code mr-2 text-blue-500"></i>Code::Blocks
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fab fa-github mr-2 text-gray-900 dark:text-white"></i>GitHub
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-server mr-2 text-green-400"></i>Laragon
                        </span>
                        <span class="tech-tag px-4 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
                            <i class="fas fa-server mr-2 text-red-400"></i>XAMPP
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
