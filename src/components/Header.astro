---
---
<header class="fixed top-0 w-full z-50 bg-white/85 dark:bg-dark/80 backdrop-blur-lg border-b border-black/[0.06] dark:border-neon/20">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">

        <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group">
            <div class="relative">
                <img src={`${import.meta.env.BASE_URL}img/mlk.jpg`} alt="Abdul Malik Adz-Dzikri" class="w-11 h-11 object-cover border border-neon/60 [clip-path:polygon(25%_0,100%_0,100%_75%,75%_100%,0_100%,0_25%)] shadow-[0_2px_8px_rgba(32,41,56,0.12)] dark:shadow-[0_0_18px_rgba(61,255,245,0.35)]">
                <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-cyborg shadow-[0_0_10px_#ff3c38] animate-pulse"></span>
            </div>
            <div class="flex flex-col">
                <span class="text-foreground dark:text-neon font-display font-bold tracking-widest leading-none uppercase text-sm">Abdul Malik</span>
                <span class="text-[10px] text-muted-foreground dark:text-neon/50 uppercase tracking-[0.3em] font-display">Unit&nbsp;//&nbsp;Informatika</span>
            </div>
        </a>

        <nav class="hidden md:flex gap-8 font-display">
            <a href={`${import.meta.env.BASE_URL}#hero`} class="text-xs uppercase tracking-[0.2em] text-gray-600 dark:text-gray-400 hover:text-neon dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.7)] transition">Home</a>
            <a href={`${import.meta.env.BASE_URL}#about`} class="text-xs uppercase tracking-[0.2em] text-gray-600 dark:text-gray-400 hover:text-neon dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.7)] transition">About</a>
            <a href={`${import.meta.env.BASE_URL}#projects`} class="text-xs uppercase tracking-[0.2em] text-gray-600 dark:text-gray-400 hover:text-neon dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.7)] transition">Projects</a>
            <a href={`${import.meta.env.BASE_URL}#contact`} class="text-xs uppercase tracking-[0.2em] text-gray-600 dark:text-gray-400 hover:text-neon dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.7)] transition">Contact</a>
        </nav>

        <div class="flex items-center gap-4">
            <button data-theme-toggle aria-label="Toggle tema terang/gelap"
                    class="w-10 h-10 bg-transparent border border-neon/50 text-neon flex items-center justify-center hover:bg-neon/10 hover:shadow-[0_0_12px_rgba(0,184,176,0.25)] dark:hover:shadow-[0_0_15px_rgba(61,255,245,0.4)] transition [clip-path:polygon(25%_0,100%_0,100%_75%,75%_100%,0_100%,0_25%)]">
                <i data-theme-icon class="fas fa-moon"></i>
            </button>

            <div class="flex gap-4 text-gray-500 dark:text-neon/70">
                <a href="https://www.instagram.com/malikzert/" class="hover:text-neon hover:-translate-y-1 dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.8)] transition transform"><i class="fab fa-instagram"></i></a>
                <a href="https://www.linkedin.com/in/abdul-malik-adz-dzikri-868194373/" class="hover:text-neon hover:-translate-y-1 dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.8)] transition transform"><i class="fab fa-linkedin-in"></i></a>
                <a href="https://www.youtube.com/@Malikadz" class="hover:text-neon hover:-translate-y-1 dark:hover:[text-shadow:0_0_12px_rgba(61,255,245,0.8)] transition transform"><i class="fab fa-youtube"></i></a>
            </div>
        </div>
    </div>
</header>
