---
<header class="fixed top-0 w-full z-50 bg-white/80 dark:bg-dark/80 backdrop-blur-lg border-b border-black/10 dark:border-white/5">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        
        <div class="flex items-center gap-3">
            <img src={`${import.meta.env.BASE_URL}img/mlk.jpg`} alt="Abdul Malik Adz-Dzikri" class="w-11 h-11 rounded-full object-cover border border-gold/50">
            <div class="flex flex-col">
                <span class="text-gold font-semibold tracking-tight leading-none">Abdul Malik Adz-Dzikri</span>
                <span class="text-[10px] text-gray-600 dark:text-gray-500 uppercase tracking-widest">Informatika / Dev</span>
            </div>
        </div>

        <nav class="hidden md:flex gap-8">
            <a href="#hero" class="text-xs uppercase tracking-[0.2em] hover:text-gold transition">Home</a>
            <a href="#about" class="text-xs uppercase tracking-[0.2em] hover:text-gold transition">About</a>
            <a href="#projects" class="text-xs uppercase tracking-[0.2em] hover:text-gold transition">Projects</a>
            <a href="#contact" class="text-xs uppercase tracking-[0.2em] hover:text-gold transition">Contact</a>
        </nav>

        <div class="flex items-center gap-4">
            <button data-theme-toggle aria-label="Toggle tema terang/gelap"
                    class="w-10 h-10 rounded-full border border-gold/40 text-gold flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition">
                <i data-theme-icon class="fas fa-moon"></i>
            </button>

            <div class="flex gap-4 text-gold">
                <a href="https://www.instagram.com/malikzert/" class="hover:text-gray-900 dark:text-white hover:-translate-y-1 transition transform"><i class="fab fa-instagram"></i></a>
                <a href="https://www.linkedin.com/in/abdul-malik-adz-dzikri-868194373/" class="hover:text-gray-900 dark:text-white hover:-translate-y-1 transition transform"><i class="fab fa-linkedin-in"></i></a>
                <a href="https://www.youtube.com/@Malikadz" class="hover:text-gray-900 dark:text-white hover:-translate-y-1 transition transform"><i class="fab fa-youtube"></i></a>
            </div>
        </div>
    </div>
</header>
