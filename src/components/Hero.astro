---
---
<section class="min-h-screen flex items-center pt-20 w-full relative" id="hero">
    <div class="container w-full max-w-[1440px] mx-auto px-5 flex flex-col md:flex-row items-center justify-between gap-12">

        <div class="flex-1 text-center md:text-left z-10">
            <p class="small flex items-center gap-3 justify-center md:justify-start">
                <span class="w-8 h-px bg-neon shadow-[0_0_8px_rgba(0,184,176,0.4)] dark:shadow-[0_0_8px_#3dfff5]"></span>
                Mahasiswa Informatika & Web Developer
            </p>
            <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-extrabold leading-[1.1] mb-8 uppercase tracking-tight">
                <span class="text-gray-500 dark:text-gray-500 text-xl md:text-2xl block mb-3 tracking-[0.3em]">// Initialize</span>
                Hello, I<br>Am <span class="text-neon dark:[text-shadow:0_0_25px_rgba(61,255,245,0.6)]">Abdul Malik</span><br><span class="text-neon dark:[text-shadow:0_0_25px_rgba(61,255,245,0.6)]">Adz-Dzikri</span>
            </h1>

            <div class="flex flex-wrap gap-5 justify-center md:justify-start">
                <a href="#contact" class="btn">Contact Me</a>
                <a href="#projects" class="btn outline">View Projects</a>
            </div>
        </div>

        <div class="flex-1 flex justify-center relative">
            <div class="absolute inset-0 m-auto w-80 h-80 rounded-full border border-neon/20 animate-spin [animation-duration:12s]"></div>
            <div class="absolute inset-0 m-auto w-[22rem] h-[22rem] rounded-full border border-dashed border-neon/10 animate-spin [animation-duration:20s] [animation-direction:reverse]"></div>
            <img src={`${import.meta.env.BASE_URL}img/mlk.jpg`} alt="Abdul Malik Adz-Dzikri"
                 class="relative w-80 h-80 object-cover border-2 border-neon/60 p-1 bg-black/5 dark:bg-neon/5 shadow-[0_10px_30px_rgba(32,41,56,0.15)] dark:shadow-[0_0_50px_rgba(61,255,245,0.25)] [clip-path:polygon(30%_0,100%_0,100%_70%,70%_100%,0_100%,0_30%)] hover:border-neon hover:shadow-[0_16px_40px_rgba(32,41,56,0.22)] dark:hover:shadow-[0_0_80px_rgba(61,255,245,0.5)] transition-all duration-500">
        </div>

    </div>
</section>
