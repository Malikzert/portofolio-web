<section id="contact" class="py-24 pb-32 w-full">
    <div class="container w-full max-w-[1200px] mx-auto px-5">
        <div class="flex flex-col md:flex-row gap-20">
            
            <div class="flex-1">
                <h2 class="section-title mb-6">Let's <span>Connect</span></h2>
                <p class="text-gray-600 dark:text-gray-400 mb-8">
                    Punya ide proyek atau sekadar ingin bertegur sapa? Saya selalu terbuka untuk kolaborasi baru.
                </p>
                
                <div class="flex items-center gap-5 mt-10 cursor-pointer group">
                    <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center text-gold group-hover:bg-gold/20 transition-all">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-gray-600 dark:text-gray-500">Email</p>
                        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=malikdark17@gmail.com&su=Tanya%20Proyek&body=Halo%20Malik,%0A%0Asaya%20tertarik%20untuk%20diskusi%20tentang%20proyek%20anda.%20Bisa%20kita%20bicarakan%20lebih%20 lanjut?" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-gold transition-all">
                            malikdark17@gmail.com
                        </a>
                    </div>
                </div>

                <div class="flex items-center gap-5 mt-8 cursor-pointer group">
                    <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center text-gold group-hover:bg-gold/20 transition-all">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-gray-600 dark:text-gray-500">WhatsApp / Phone</p>
                        <a href="https://wa.me/6285259264009?text=Halo%20Malik,%20saya%20ingin%20mengajak%20kolaborasi%20proyek%20dengan%20Anda.%20Bisa%20kita%20diskusikan%20lebih%20 lanjut?" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-gold transition-all">
                            +62 852-5926-4009
                        </a>
                    </div>
                </div>
            </div>

            <div class="flex-1 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 p-8 rounded-2xl">
                <form class="space-y-5" onsubmit="event.preventDefault(); const name = document.getElementById('name').value; const message = document.getElementById('message').value; const text = 'Halo%20Malik,%20saya%20' + encodeURIComponent(name) + '%20ingin%20menghubungi%20Anda:%20' + encodeURIComponent(message); window.open('https://wa.me/6285259264009?text=' + text, '_blank');">
                    <div class="input-group">
                        <input type="text" id="name" placeholder="Your Name" required class="w-full px-5 py-4 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:border-gold focus:outline-none transition">
                    </div>
                    <div class="input-group">
                        <input type="email" placeholder="Your Email" required class="w-full px-5 py-4 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:border-gold focus:outline-none transition">
                    </div>
                    <div class="input-group">
                        <textarea id="message" placeholder="Your Message" rows="5" required class="w-full px-5 py-4 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:border-gold focus:outline-none transition resize-none"></textarea>
                    </div>
                    <button type="submit" class="btn w-full">Send Message</button>
                </form>
            </div>

        </div>
    </div>
</section>
