---
---
<section id="contact" class="py-24 pb-32 w-full">
    <div class="container w-full max-w-[1440px] mx-auto px-5">
        <div class="flex flex-col md:flex-row justify-between gap-20">
            
            <div class="flex-1">
                <p class="small">// Transmit</p>
                <h2 class="section-title mb-6">Let's <span>Connect</span></h2>
                <p class="text-gray-600 dark:text-gray-400 mb-8">
                    Punya ide proyek atau sekadar ingin bertegur sapa? Saya selalu terbuka untuk kolaborasi baru.
                </p>
                
                <div class="flex items-center gap-5 mt-10 cursor-pointer group">
                    <div class="w-12 h-12 bg-neon/10 border border-neon/30 flex items-center justify-center text-neon group-hover:bg-neon/20 group-hover:shadow-[0_10px_24px_rgba(0,184,176,0.25)] dark:group-hover:shadow-[0_0_20px_rgba(61,255,245,0.4)] transition-all [clip-path:polygon(25%_0,100%_0,100%_75%,75%_100%,0_100%,0_25%)]">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-gray-600 dark:text-neon/50 font-display">Email</p>
                        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=malikdark17@gmail.com&su=Tanya%20Proyek&body=Halo%20Malik,%0A%0Asaya%20tertarik%20untuk%20diskusi%20tentang%20proyek%20anda.%20Bisa%20kita%20bicarakan%20lebih%20 lanjut?" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-neon transition-all">
                            malikdark17@gmail.com
                        </a>
                    </div>
                </div>

                <div class="flex items-center gap-5 mt-8 cursor-pointer group">
                    <div class="w-12 h-12 bg-neon/10 border border-neon/30 flex items-center justify-center text-neon group-hover:bg-neon/20 group-hover:shadow-[0_10px_24px_rgba(0,184,176,0.25)] dark:group-hover:shadow-[0_0_20px_rgba(61,255,245,0.4)] transition-all [clip-path:polygon(25%_0,100%_0,100%_75%,75%_100%,0_100%,0_25%)]">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-gray-600 dark:text-neon/50 font-display">WhatsApp / Phone</p>
                        <a href="https://wa.me/6285259264009?text=Halo%20Malik,%20saya%20ingin%20mengajak%20kolaborasi%20proyek%20dengan%20Anda.%20Bisa%20kita%20diskusikan%20lebih%20 lanjut?" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-neon transition-all">
                            +62 852-5926-4009
                        </a>
                    </div>
                </div>
            </div>

            <div class="flex-1 bg-black/5 dark:bg-neon/5 border border-black/10 dark:border-neon/25 p-8 [clip-path:polygon(24px_0,100%_0,100%_calc(100%_-_24px),calc(100%_-_24px)_100%,0_100%,0_24px)]">
                <form class="space-y-5" onsubmit="event.preventDefault(); const name = document.getElementById('name').value; const message = document.getElementById('message').value; const text = 'Halo%20Malik,%20saya%20' + encodeURIComponent(name) + '%20ingin%20menghubungi%20Anda:%20' + encodeURIComponent(message); window.open('https://wa.me/6285259264009?text=' + text, '_blank');">
                    <div class="input-group">
                        <input type="text" id="name" placeholder="Your Name" required class="w-full px-5 py-4 bg-black/5 dark:bg-neon/5 border border-black/10 dark:border-neon/20 rounded-md text-gray-900 dark:text-white placeholder-gray-500 focus:border-neon focus:outline-none focus:shadow-[0_6px_18px_rgba(0,184,176,0.18)] dark:focus:shadow-[0_0_20px_rgba(61,255,245,0.25)] transition">
                    </div>
                    <div class="input-group">
                        <input type="email" placeholder="Your Email" required class="w-full px-5 py-4 bg-black/5 dark:bg-neon/5 border border-black/10 dark:border-neon/20 rounded-md text-gray-900 dark:text-white placeholder-gray-500 focus:border-neon focus:outline-none focus:shadow-[0_6px_18px_rgba(0,184,176,0.18)] dark:focus:shadow-[0_0_20px_rgba(61,255,245,0.25)] transition">
                    </div>
                    <div class="input-group">
                        <textarea id="message" placeholder="Your Message" rows="5" required class="w-full px-5 py-4 bg-black/5 dark:bg-neon/5 border border-black/10 dark:border-neon/20 rounded-md text-gray-900 dark:text-white placeholder-gray-500 focus:border-neon focus:outline-none focus:shadow-[0_6px_18px_rgba(0,184,176,0.18)] dark:focus:shadow-[0_0_20px_rgba(61,255,245,0.25)] transition resize-none"></textarea>
                    </div>
                    <button type="submit" class="btn w-full">Send Message</button>
                </form>
            </div>

        </div>
    </div>
</section>
